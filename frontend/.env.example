# Frontend API base URL.
#
# Empty (default): the Vite dev server proxies /auth, /profile, /projects,
# /hiring and /ai to the API Gateway on http://localhost:8080 (see
# vite.config.ts), so the browser only ever talks to the dev origin.
#
# Production / builds served without the dev proxy: set the full gateway
# origin here. Example:
# VITE_API_BASE_URL=http://localhost:8080
#
# NOTE: frontend environment variables are NOT secret — never put JWT
# secrets, database passwords, or credentials in this file.
VITE_API_BASE_URL=
