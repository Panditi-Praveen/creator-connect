# CreatorConnect — Required Environment Variables
#
# Copy this file to .env and fill in real values before starting services.
#   cp .env.example .env
#
# For local development without Docker, export these in your shell:
#   export APP_JWT_SECRET="your-secret-here"
#   export MYSQL_PASSWORD="your-mysql-password"

# MySQL (used by auth, profile, project, hiring services)
MYSQL_URL=jdbc:mysql://localhost:3307/creatorconnect?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USER=root
MYSQL_PASSWORD=changeme

# JWT — shared HMAC secret across ALL services.
# Generate with: openssl rand -base64 64
APP_JWT_SECRET=changeme

# OpenAI (optional — AI Service works without it, /ai/discover returns 503)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email (optional — hiring service skips sends when MAIL_ENABLED=false)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM_ADDRESS=noreply@creatorconnect.app
MAIL_FROM_NAME=CreatorConnect
