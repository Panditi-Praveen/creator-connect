# CreatorConnect — environment variable template
# ------------------------------------------------------------------
# Copy this file to `.env` for docker-compose (compose reads `.env`
# automatically), or export the variables in your shell before running
# the services with Maven. NEVER commit real values — this file and
# `.env` contain placeholders/real values respectively; only this
# template (placeholders) is committed.
# ------------------------------------------------------------------

# --- Database (required by auth, profile, project, hiring) ----------
# Password for the MySQL user the services connect with. Required.
MYSQL_PASSWORD=change-me-strong-db-password

# MySQL user the services connect with (defaults to root if unset).
MYSQL_USER=root

# JDBC URL for the MySQL database. Local default shown below; in Docker
# use: jdbc:mysql://mysql:3306/creatorconnect?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_URL=jdbc:mysql://localhost:3306/creatorconnect?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# --- Docker Compose only --------------------------------------------
# Root password for the mysql container (required by docker-compose.yml).
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

# --- JWT (required by auth, profile, project, hiring, ai) -------------
# HMAC key used to sign (auth) and validate (all services) JWTs.
# MUST be identical across all five services. Generate a strong value:
#   openssl rand -base64 64
#   (or: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(64)).decode())")
APP_JWT_SECRET=replace-with-output-of-openssl-rand-base64-64

# --- AI Service (optional) ---------------------------------------------
# OpenAI API key used by the AI Service for natural-language talent
# discovery. OPTIONAL: when missing or blank, GET /ai/status still works but
# POST /ai/discover returns a clean 503 configuration error (documented
# contract) instead of a fake response. Do not commit a real key.
OPENAI_API_KEY=

# Optional LLM overrides (defaults shown):
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
